{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facts/state.schema.json",
  "title": "Showcase fact package",
  "description": "Sanitized facts from the source project. It is the only input for the README, the ADRs, finops/ and the roadmap. Nothing outside this file and facts/decisions/ may become a claim in the showcase.",
  "type": "object",
  "required": [
    "packageVersion",
    "generatedAt",
    "architecture",
    "clouds",
    "finops",
    "quality",
    "process",
    "roadmap"
  ],
  "additionalProperties": false,
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "published",
        "implemented",
        "in-test",
        "evaluated",
        "planned",
        "reserve",
        "legacy",
        "discarded"
      ]
    },
    "limit": {
      "type": "object",
      "required": [
        "resource",
        "quota",
        "unit",
        "period"
      ],
      "additionalProperties": false,
      "properties": {
        "resource": {
          "type": "string"
        },
        "quota": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "packageVersion": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "architecture": {
      "type": "object",
      "required": [
        "pattern",
        "summary",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "layer",
              "technology",
              "role",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "layer": {
                "type": "string",
                "enum": [
                  "client",
                  "local-data",
                  "edge",
                  "identity",
                  "cloud-data",
                  "compute",
                  "ci",
                  "operations"
                ]
              },
              "technology": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "state": {
                "$ref": "#/$defs/state"
              },
              "connectsTo": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "clouds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "rule",
          "services",
          "protections"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "service",
                "state",
                "role"
              ],
              "additionalProperties": false,
              "properties": {
                "service": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "state": {
                  "$ref": "#/$defs/state"
                },
                "role": {
                  "type": "string"
                },
                "limits": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/limit"
                  }
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "protections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "description",
                "state"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "policy",
                    "quota",
                    "budget",
                    "alert",
                    "no-overage-sku",
                    "none"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "active",
                    "planned",
                    "absent"
                  ]
                },
                "verification": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "finops": {
      "type": "object",
      "required": [
        "operationalLimitPercent",
        "measurements"
      ],
      "additionalProperties": false,
      "properties": {
        "operationalLimitPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "unit",
              "how"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "how": {
                "type": "string"
              }
            }
          }
        },
        "reevaluationTriggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "suites",
        "practices"
      ],
      "additionalProperties": false,
      "properties": {
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "tool",
              "target",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "practices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "process": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "type": "object",
      "description": "What the README front page shows. Each entry repeats, exactly, an entry of finops.measurements (by name), quality.practices or process; verify-facts rejects an entry that does not exist. The complete lists go to docs/engineering.md.",
      "additionalProperties": false,
      "properties": {
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "practices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "state": {
            "$ref": "#/$defs/state"
          },
          "condition": {
            "type": "string"
          }
        }
      }
    }
  }
}
