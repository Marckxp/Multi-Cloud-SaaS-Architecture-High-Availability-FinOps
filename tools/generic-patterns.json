{
  "description": "Patterns that must never appear in the showcase. Terms from the source project are NOT listed here: they live outside the repository (the VITRINE_PROIBIDOS secret in CI, a local file on the machine of whoever generates the package).",
  "patterns": [
    { "id": "guid", "description": "GUID (subscription, tenant, resource)", "regex": "\\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b", "flags": "i" },
    { "id": "ocid", "description": "Oracle Cloud OCID", "regex": "\\bocid1\\.[a-z0-9]+\\.[a-z0-9.]+", "flags": "i" },
    { "id": "ipv4", "description": "Public IPv4 address", "regex": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b", "flags": "" },
    { "id": "email", "description": "Email address", "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "flags": "" },
    { "id": "cloud-host", "description": "Provider-generated hostname (reveals an account or resource)", "regex": "\\b[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.(?:workers\\.dev|pages\\.dev|azurestaticapps\\.net|azurewebsites\\.net|run\\.app|firebaseapp\\.com|web\\.app|appspot\\.com|firebasestorage\\.app|oraclecloud\\.com)\\b", "flags": "i" },
    { "id": "google-key", "description": "Google/Firebase API key", "regex": "AIza[0-9A-Za-z_\\-]{35}", "flags": "" },
    { "id": "google-billing", "description": "Google Cloud billing account", "regex": "\\b[0-9A-F]{6}-[0-9A-F]{6}-[0-9A-F]{6}\\b", "flags": "" },
    { "id": "github-token", "description": "GitHub token", "regex": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,})\\b", "flags": "" },
    { "id": "private-key", "description": "Private key", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "flags": "" },
    { "id": "windows-machine", "description": "Default Windows machine name", "regex": "\\bDESKTOP-[A-Z0-9]{7}\\b", "flags": "" },
    { "id": "user-path", "description": "Path containing a user folder", "regex": "(?:[A-Za-z]:\\\\Users\\\\|/home/|/Users/)[A-Za-z0-9._-]+", "flags": "" }
  ],
  "allowed": [
    { "pattern": "guid", "regex": "^0{8}-0{4}-0{4}-0{4}-0{12}$" },
    { "pattern": "ipv4", "regex": "^(?:10\\.|127\\.|192\\.168\\.|172\\.(?:1[6-9]|2\\d|3[01])\\.|0\\.0\\.0\\.0|255\\.|192\\.0\\.2\\.|198\\.51\\.100\\.|203\\.0\\.113\\.)" },
    { "pattern": "email", "regex": "^(?:noreply@github\\.com|support@github\\.com|noreply@anthropic\\.com|[^@]+@users\\.noreply\\.github\\.com|[^@]+@example\\.(?:com|org))$", "flags": "i" },
    { "pattern": "cloud-host", "regex": "^(?:example|your-app|<[^>]+>)\\.", "flags": "i" },
    { "pattern": "user-path", "regex": "^(?:/home/runner|/home/ubuntu)$" }
  ],
  "ignore": ["tools/generic-patterns.json", "LICENSE"]
}
